# --- Server ---
PORT=5324
ADMIN_PASSWORD=change-me-now

# Public base URL used in verification + referral links inside emails
# BASE_URL=https://waitlist.yourdomain.com

# --- Data ---
# DB_PATH=./data/queuecraft.db

# --- Email (BYO SMTP — can also be configured in the admin UI) ---
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=postmaster@example.com
# SMTP_PASS=secret
# SMTP_FROM=waitlist@example.com
# Set to true to disable all sending (signups still work)
# SMTP_DISABLED=false

# --- Anti-spam tuning ---
# RATE_LIMIT_SIGNUPS=5            # signups per IP per window
# RATE_LIMIT_WINDOW_MS=3600000    # 1 hour
# REFERRAL_IP_CREDIT_CAP=3        # max credited referrals per referrer from one IP

# --- Email queue ---
# EMAIL_QUEUE_INTERVAL_MS=15000
